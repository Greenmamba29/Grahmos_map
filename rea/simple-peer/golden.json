  {
    "name": "trickle signals offer, candidates, answer",
    "input": {
      "trickle": true,
      "messages": [
        {
          "text": "t"
        }
      ]
    },
    "expected": {
      "value": {
        "out": {
          "signals1": [
            "offer",
            "candidate"
          ],
          "signals2": [
            "answer",
