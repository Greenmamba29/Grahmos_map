[
  {
    "name": "non-trickle text messages",
    "input": {
      "messages": [
        {
          "text": "hello"
        },
        {
          "text": "ünïcode ✓ 🗺️"
        }
      ]
    },
    "expected": {
      "value": {
        "out": {
          "signals1": [
            "offer"
          ],
          "signals2": [
            "answer"
          ],
          "events": [
            "p1:connect",
            "p2:connect"
          ],
          "received": [
            {
              "kind": "bytes",
              "bytes": [
                104,
                101,
                108,
                108,
                111
              ],
              "length": 5,
              "text": "hello"
            },
            {
              "kind": "bytes",
              "bytes": [
                195,
                188,
                110,
                195,
                175,
                99,
                111,
                100
              ],
              "length": 21,
              "text": "ünïcode ✓ 🗺️"
            }
          ],
          "errors": []
        }
      }
    }
  },
  {
    "name": "objectMode keeps strings as strings",
    "input": {
      "objectMode": true,
      "messages": [
        {
          "text": "hello"
        },
        {
          "text": "second"
        }
      ]
    },
    "expected": {
      "value": {
        "out": {
          "signals1": [
            "offer"
          ],
          "signals2": [
            "answer"
          ],
          "events": [
            "p1:connect",
            "p2:connect"
          ],
          "received": [
            {
              "kind": "string",
              "text": "hello"
            },
            {
              "kind": "string",
              "text": "second"
            }
          ],
          "errors": []
        }
      }
    }
  },
