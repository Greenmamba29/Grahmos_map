# ---------------------------------------------------------------------------
# Resilience Maps configuration
# Every value is optional: with an empty file the app runs on bundled seed data
# and an online raster fallback basemap, so the UI is fully explorable.
# ---------------------------------------------------------------------------

# Supabase (facility registry + PostGIS geospatial queries)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Offline vector basemap: single-file PMTiles archive served with range requests.
# Generate with ./scripts/make-pmtiles.sh
VITE_BASEMAP_PMTILES_URL=/tiles/region.pmtiles

# Terrain-RGB DEM archive used for hillshade, 3D terrain and elevation profiles.
# Generate with ./scripts/make-terrain.sh
VITE_TERRAIN_PMTILES_URL=/tiles/terrain.pmtiles

# Optional satellite raster source (XYZ template)
VITE_SATELLITE_TILES_URL=

# Online raster fallback, used only when no PMTiles archive is reachable
VITE_FALLBACK_RASTER_TILES_URL=https://basemaps.cartocdn.com/light_all/{z}/{x}/{y}.png

# Default camera: "lon,lat" and zoom
VITE_DEFAULT_CENTER=-72.3350,18.5392
VITE_DEFAULT_ZOOM=12

# Server-side seeding only (never exposed to the client bundle)
SUPABASE_DB_URL=
SUPABASE_SERVICE_ROLE_KEY=
