# Supabase (leave empty to run entirely on bundled demo data)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Offline tiles (see INSTALLATION_GUIDE.md §5 to generate these)
# When unset the app falls back to the free OpenFreeMap online style.
VITE_BASEMAP_PMTILES_URL=
VITE_TERRAIN_PMTILES_URL=

# Initial map view
VITE_DEFAULT_CENTER=-122.4194,37.7749
VITE_DEFAULT_ZOOM=13
