{
  "name": "Resilience Maps",
  "short_name": "Resilience",
  "description": "Offline-first mapping for critical infrastructure during connectivity outages.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#ffffff",
