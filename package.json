{
  "name": "grahmos-maps",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "osa:gate": "node osa-kit/gate/osa-gate.mjs",
    "check:contrast": "python3 scripts/check-contrast.py",
    "check:lockfile": "node scripts/check-lockfile.mjs",
    "check:placeholders": "! grep -rn \"{{[A-Z_]*}}\" public src --include=*.ts --include=*.tsx --include=*.js --include=*.html --include=*.webmanifest",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run cap:sync && cap open android",
    "cap:ios": "npm run cap:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@grahmos/capacitor-ble-mesh": "file:plugins/grahmos-ble-mesh",
    "@noble/ed25519": "^3.2.0",
    "@noble/hashes": "^2.4.0",
    "fflate": "^0.8.3",
    "idb": "^8.0.3",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/web-bluetooth": "^0.0.22",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.10.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  }
}
